diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 02bb4f0fb5..980e578e09 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -122,3 +122,40 @@ patchedDependencies:
   mdast-util-gfm-autolink-literal@2.0.1: patches/mdast-util-gfm-autolink-literal@2.0.1.patch
   micromark-extension-gfm-autolink-literal@2.1.0: patches/micromark-extension-gfm-autolink-literal@2.1.0.patch
   node-pty@1.2.0-beta.15: patches/node-pty@1.2.0-beta.15.patch
+
+# --- Cross-platform native binary support (FreeBSD port + CI + dev machines) ---
+# pnpm v11 reads these from pnpm-workspace.yaml, NOT package.json's `pnpm` field.
+# - `freebsd` + `wasm32`: force-install sharp's FreeBSD/WASM runtime. sharp ships
+#   NO native freebsd-x64 binary, so the wasm fallback
+#   (@img/sharp-freebsd-wasm32 -> @img/sharp-wasm32) is the only working image
+#   backend on FreeBSD.
+# - `linux`/`darwin`/`win32` + `arm64` + `libc: [glibc, musl]`: REQUIRED so that
+#   `pnpm install` on non-FreeBSD hosts (GitHub linux-x64 CI runner, macOS/Windows
+#   dev machines) actually fetches the platform-native optional binaries
+#   (lightningcss-linux-x64-gnu, @esbuild/linux-x64, rollup-linux-x64-gnu, ...).
+#   Without these, tsdown/esbuild fail at runtime with
+#   "Cannot find module '...linux-x64-gnu.node'".
+# NOTE: `libc` MUST be `glibc`/`musl` — the formerly-used `any` is NOT a valid
+# value and silently filters out every glibc/musl-native optional dependency.
+# `os`/`cpu` are additive to the *current* platform, so listing freebsd here does
+# NOT drop the host's own binaries; it only broadens which optional deps are kept.
+# pnpm downloads optional platform binaries for EVERY listed platform (union
+# semantics); the default is the current host only. Non-FreeBSD hosts (GitHub
+# CI linux-x64, macOS/Windows dev machines) match their own host natively, so
+# they need NO entry here. Only FreeBSD + the sharp WASM fallback (cpu axis)
+# are declared.
+supportedArchitectures:
+  os:
+    - freebsd
+  cpu:
+    - x64
+    - wasm32
+# Hoist every workspace + dependency package into the top-level node_modules so
+# the runtime loader's dynamic import('@deepseek-ai/dsh-client-ui-*') resolves.
+shamefullyHoist: true
+# Belt-and-suspenders: make sharp explicitly declare its FreeBSD/WASM runtimes.
+packageExtensions:
+  'sharp@*':
+    optionalDependencies:
+      '@img/sharp-freebsd-wasm32': '*'
+      '@img/sharp-wasm32': '*'
